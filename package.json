{
  "name": "@0k/rrd-graph",
  "version": "%%version%%",
  "description": "Vue 3 graph card for kal-rrd-graph time series: visible-first loading, live tails and linked pan/zoom.",
  "keywords": ["vue", "vue3", "rrd", "time-series", "chart", "kal-rrd-graph"],
  "author": "Valentin Lab <valentin.lab@kalysto.org>",
  "license": "MIT",
  "homepage": "https://github.com/0k/rrd-graph",
  "repository": { "type": "git", "url": "git+https://github.com/0k/rrd-graph.git" },
  "bugs": { "url": "https://github.com/0k/rrd-graph/issues" },
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "README.md", "LICENSE"],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./api": { "types": "./dist/api.d.ts", "default": "./dist/api.js" },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test:package": "RRD_GRAPH_PACKAGE_TEST=1 vitest run test/dist.check.mjs",
    "check": "npm run test && npm run typecheck && npm run build && npm run test:package"
  },
  "peerDependencies": { "vue": "^3.5.12" },
  "dependencies": {
    "@0k/kal-sse-client": "^0.2.0",
    "@0k/time-chart": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  }
}
